{
  "name": "offer-hunter",
  "displayName": "Offer Hunter",
  "version": "1.3.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "description": "用你自己配置的 AI 分析简历与招聘网站岗位 JD 的匹配度，并按你的规则生成定制打招呼语。",
  "scripts": {
    "dev": "pnpm run clear && cross-env NODE_ENV=development run-p dev:*",
    "dev-firefox": "pnpm run clear && cross-env NODE_ENV=development EXTENSION=firefox run-p dev:*",
    "dev:prepare": "esno scripts/prepare.ts",
    "dev:background": "pnpm run build:background -- --mode development",
    "dev:js": "cross-env NODE_ENV=development esno scripts/build-sites.ts content --watch",
    "dev:injected": "cross-env NODE_ENV=development esno scripts/build-sites.ts injected --watch",
    "dev:web": "vite",
    "build": "cross-env NODE_ENV=production run-s clear build:web build:prepare build:background build:js build:injected",
    "build:prepare": "esno scripts/prepare.ts",
    "build:background": "vite build --config vite.config.background.mts",
    "build:js": "esno scripts/build-sites.ts content",
    "build:injected": "esno scripts/build-sites.ts injected",
    "build:web": "vite build",
    "pack": "cross-env NODE_ENV=production run-p pack:zip pack:crx",
    "pack:zip": "node -e \"require('node:fs').rmSync('extension.zip', { force: true })\" && jszip-cli add extension/* -o ./extension.zip",
    "pack:crx": "crx3 extension -o ./extension.crx --keyPath key.pem",
    "pack:xpi": "cross-env WEB_EXT_ARTIFACTS_DIR=./ web-ext build --source-dir ./extension --filename extension.xpi --overwrite-dest",
    "pack:firefox": "cross-env NODE_ENV=production EXTENSION=firefox run-s clear build pack:xpi",
    "start:chromium": "web-ext run --source-dir ./extension --target=chromium",
    "start:firefox": "web-ext run --source-dir ./extension --target=firefox-desktop",
    "clear": "esno scripts/clean.ts",
    "icons": "esno scripts/icons.ts",
    "lint": "eslint --cache .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "postinstall": "simple-git-hooks",
    "typecheck": "tsc --noEmit",
    "release": "bumpp"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@ffflorian/jszip-cli": "^3.16.8",
    "@iconify-json/tabler": "^1.2.40",
    "@playwright/test": "^1.63.0",
    "@shikijs/monaco": "^4.4.3",
    "@types/node": "^26.6.3",
    "@types/webextension-polyfill": "^0.12.6",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@unocss/reset": "^66.10.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "bumpp": "^12.3.0",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "crx3": "^2.0.0",
    "eslint": "^10.11.0",
    "esno": "^4.8.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "kolorist": "^1.8.0",
    "monaco-editor-core": "^0.57.0",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "sharp": "^0.35.5",
    "shiki": "^4.4.3",
    "simple-git-hooks": "^2.14.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unocss": "^66.10.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "vue-demi": "^0.14.10",
    "web-ext": "^10.7.0",
    "webext-bridge": "^6.0.1",
    "webextension-polyfill": "^0.12.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,vue,json,jsonc,json5,md,css,scss,less,html}": "eslint --fix"
  }
}
